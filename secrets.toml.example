# Copy this to .streamlit/secrets.toml locally (gitignored), or paste the
# same keys/values into Streamlit Community Cloud's "Secrets" panel for
# this app (Settings -> Secrets) when deployed. Never commit real values.

ANGEL_API_KEY = "your_api_key"
ANGEL_CLIENT_ID = "your_client_id"
ANGEL_PASSWORD = "your_password_or_mpin"
ANGEL_TOTP_SECRET = "your_totp_secret"

# Used by the app to pull this morning's auto-generated files straight
# from your GitHub repo (raw.githubusercontent.com URL, no auth needed
# for a public repo's raw files):
GITHUB_RAW_BASE = "https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main/data"
