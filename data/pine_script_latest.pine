//@version=5
indicator("Options Reversal Zones - NIFTY 14 Aug 2026 | Expiry: 18AUG2026", overlay=true, max_lines_count=500, max_labels_count=500)

// -- Strike Selector --
// Add this indicator to the UNDERLYING chart (e.g. NIFTY spot/futures),
// not an option chart -- Auto-ATM needs the underlying's live close price.
auto_atm = input.bool(true, "Auto-track ATM to live price")
selected = input.string("24400", "Manual Strike (used when Auto-track is off)", options=["23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750", "24800", "24850", "24900"])

// -- Zone Toggles --
show_avg    = input.bool(true,  "Individual Average")
show_bl     = input.bool(true,  "Boundary Line")
show_uce    = input.bool(true,  "Upper Reversal Zone CE")
show_upe    = input.bool(true,  "Upper Reversal Zone PE")
show_lce    = input.bool(true,  "Lower Reversal Zone CE")
show_lpe    = input.bool(true,  "Lower Reversal Zone PE")
show_lbl    = input.bool(true,  "Show Labels")
lw          = input.int(1, "Line Width", minval=1, maxval=4)

// -- Data (pulled from Angel One this morning, computed here) --
var string[] strike_arr  = array.from("23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750", "24800", "24850", "24900")
var float[]  avg_arr     = array.from(273.3500, 249.4500, 226.9500, 204.4500, 182.8000, 163.1250, 145.3250, 130.1250, 117.4000, 108.1250, 102.4500, 100.5500, 103.4000, 109.1000, 119.2250, 133.2250, 149.2000, 168.1500, 188.6750, 210.8750, 234.1750)
var float[]  bl_arr      = array.from(0, 0, 178.1500, 156.6500, 136.1750, 117.3500, 100.2250, 85.5500, 74.0250, 65.5500, 60.5000, 58.9250, 60.9750, 66.7250, 76.5500, 88.6250, 103.9750, 122.3500, 141.7000, 161.4000, 184.1500)
var float[]  uce133_arr  = array.from(721.7910, 656.4880, 594.0445, 530.9360, 468.5590, 409.6400, 352.5830, 299.2500, 248.9095, 203.2905, 162.9250, 127.4805, 97.5555, 72.4185, 52.6015, 37.5060, 26.1345, 17.9550, 12.0365, 8.5785, 6.1845)
var float[]  uce15_arr   = array.from(814.0500, 740.4000, 669.9750, 598.8000, 528.4500, 462.0000, 397.6500, 337.5000, 280.7250, 229.2750, 183.7500, 143.7750, 110.0250, 81.6750, 59.3250, 42.3000, 29.4750, 20.2500, 13.5750, 9.6750, 6.9750)
var float[]  upe133_arr  = array.from(5.3200, 7.0490, 9.6425, 12.9010, 17.6890, 24.2725, 33.9815, 46.8825, 63.3745, 84.3220, 109.5920, 139.9825, 177.4885, 217.7875, 264.5370, 316.8725, 370.7375, 429.3240, 489.8390, 552.3490, 616.7210)
var float[]  upe15_arr   = array.from(6.0000, 7.9500, 10.8750, 14.5500, 19.9500, 27.3750, 38.3250, 52.8750, 71.4750, 95.1000, 123.6000, 157.8750, 200.1750, 245.6250, 298.3500, 357.3750, 418.1250, 484.2000, 552.4500, 622.9500, 695.5500)
var float[]  lce15_arr   = array.from(361.8000, 329.0667, 297.7667, 266.1333, 234.8667, 205.3333, 176.7333, 150.0000, 124.7667, 101.9000, 81.6667, 63.9000, 48.9000, 36.3000, 26.3667, 18.8000, 13.1000, 9.0000, 6.0333, 4.3000, 3.1000)
var float[]  lce2_arr    = array.from(180.9000, 164.5333, 148.8833, 133.0667, 117.4333, 102.6667, 88.3667, 75.0000, 62.3833, 50.9500, 40.8333, 31.9500, 24.4500, 18.1500, 13.1833, 9.4000, 6.5500, 4.5000, 3.0167, 2.1500, 1.5500)
var float[]  lpe15_arr   = array.from(2.6667, 3.5333, 4.8333, 6.4667, 8.8667, 12.1667, 17.0333, 23.5000, 31.7667, 42.2667, 54.9333, 70.1667, 88.9667, 109.1667, 132.6000, 158.8333, 185.8333, 215.2000, 245.5333, 276.8667, 309.1333)
var float[]  lpe2_arr    = array.from(1.3333, 1.7667, 2.4167, 3.2333, 4.4333, 6.0833, 8.5167, 11.7500, 15.8833, 21.1333, 27.4667, 35.0833, 44.4833, 54.5833, 66.3000, 79.4167, 92.9167, 107.6000, 122.7667, 138.4333, 154.5667)

f_line(y, col, w) =>
    line.new(bar_index-1, y, bar_index, y, extend=extend.both, color=col, width=w)

f_lbl(y, txt, col) =>
    if show_lbl
        label.new(bar_index, y, txt, xloc=xloc.bar_index, yloc=yloc.price,
                  style=label.style_label_left, color=color.new(col,80),
                  textcolor=col, size=size.small)

// -- Auto-ATM: pick the strike in our list nearest the live close --
f_nearest_idx() =>
    var int best = 0
    minDiff = 1e10
    for i = 0 to array.size(strike_arr) - 1
        sk = str.tonumber(array.get(strike_arr, i))
        d = math.abs(close - sk)
        if d < minDiff
            minDiff := d
            best := i
    best

idx = auto_atm ? f_nearest_idx() : array.indexof(strike_arr, selected)

if barstate.islast and idx >= 0
    s = array.get(strike_arr, idx)
    if show_avg
        v = array.get(avg_arr, idx)
        f_line(v, color.new(color.gray, 20), lw)
        f_lbl(v, s + " Avg " + str.tostring(v, "#.00"), color.gray)
    if show_bl
        v = array.get(bl_arr, idx)
        f_line(v, color.new(color.orange, 20), lw)
        f_lbl(v, s + " BL " + str.tostring(v, "#.00"), color.orange)
    if show_uce
        v = array.get(uce133_arr, idx)
        f_line(v, color.new(color.red, 20), lw)
        f_lbl(v, s + " UCEx1.33 " + str.tostring(v, "#.00"), color.red)
        v := array.get(uce15_arr, idx)
        f_line(v, color.new(color.red, 40), lw)
        f_lbl(v, s + " UCEx1.5 " + str.tostring(v, "#.00"), color.red)
    if show_upe
        v = array.get(upe133_arr, idx)
        f_line(v, color.new(color.purple, 20), lw)
        f_lbl(v, s + " UPEx1.33 " + str.tostring(v, "#.00"), color.purple)
        v := array.get(upe15_arr, idx)
        f_line(v, color.new(color.purple, 40), lw)
        f_lbl(v, s + " UPEx1.5 " + str.tostring(v, "#.00"), color.purple)
    if show_lce
        v = array.get(lce15_arr, idx)
        f_line(v, color.new(color.teal, 20), lw)
        f_lbl(v, s + " LCEx1.5 " + str.tostring(v, "#.00"), color.teal)
        v := array.get(lce2_arr, idx)
        f_line(v, color.new(color.teal, 40), lw)
        f_lbl(v, s + " LCEx2 " + str.tostring(v, "#.00"), color.teal)
    if show_lpe
        v = array.get(lpe15_arr, idx)
        f_line(v, color.new(color.blue, 20), lw)
        f_lbl(v, s + " LPEx1.5 " + str.tostring(v, "#.00"), color.blue)
        v := array.get(lpe2_arr, idx)
        f_line(v, color.new(color.blue, 40), lw)
        f_lbl(v, s + " LPEx2 " + str.tostring(v, "#.00"), color.blue)

plot(na, "Individual Average",     color=color.gray)
plot(na, "Boundary Line",          color=color.orange)
plot(na, "Upper Reversal Zone CE", color=color.red)
plot(na, "Upper Reversal Zone PE", color=color.purple)
plot(na, "Lower Reversal Zone CE", color=color.teal)
plot(na, "Lower Reversal Zone PE", color=color.blue)