//@version=5
indicator("Options Reversal Zones - NIFTY 17 Aug 2026 | Expiry: 18AUG2026", overlay=true, max_lines_count=500, max_labels_count=500)

// -- Strike Selector --
// Add this indicator to the UNDERLYING chart (e.g. NIFTY spot/futures),
// not an option chart -- Auto-ATM needs the underlying's live close price.
auto_atm = input.bool(true, "Auto-track ATM to live price")
selected = input.string("24300", "Manual Strike (used when Auto-track is off)", options=["23800", "23850", "23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750", "24800"])

// -- Zone Toggles --
show_avg    = input.bool(true,  "Individual Average")
show_bl     = input.bool(true,  "Boundary Line")
show_uce    = input.bool(true,  "Upper Reversal Zone CE")
show_upe    = input.bool(true,  "Upper Reversal Zone PE")
show_lce    = input.bool(true,  "Lower Reversal Zone CE")
show_lpe    = input.bool(true,  "Lower Reversal Zone PE")
show_lbl    = input.bool(true,  "Show Labels")
lw          = input.int(1, "Line Width", minval=1, maxval=4)

// -- Data (pulled from Angel One this morning, computed here) --
var string[] strike_arr  = array.from("23800", "23850", "23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750", "24800")
var float[]  avg_arr     = array.from(257.1250, 235.0000, 208.6500, 183.7000, 159.8250, 136.2750, 113.8500, 94.0250, 77.2250, 66.1000, 61.5250, 64.0000, 73.3500, 87.7250, 106.2750, 127.1250, 149.7000, 172.6000, 197.0500, 221.4000, 245.8000)
var float[]  bl_arr      = array.from(0, 0, 158.8750, 134.8000, 111.1500, 89.0750, 68.3250, 50.9750, 37.5250, 28.8250, 25.2500, 26.8750, 33.9250, 45.3750, 61.5250, 80.4250, 101.7500, 124.5250, 148.0500, 170.6250, 195.5250)
var float[]  uce133_arr  = array.from(681.6250, 622.4400, 551.8835, 484.9845, 420.2800, 355.9080, 292.5335, 233.2820, 176.8900, 129.0100, 89.5090, 59.8500, 38.6365, 24.6715, 16.0930, 10.3075, 7.1820, 5.2535, 4.0565, 3.3915, 2.7930)
var float[]  uce15_arr   = array.from(768.7500, 702.0000, 622.4250, 546.9750, 474.0000, 401.4000, 329.9250, 263.1000, 199.5000, 145.5000, 100.9500, 67.5000, 43.5750, 27.8250, 18.1500, 11.6250, 8.1000, 5.9250, 4.5750, 3.8250, 3.1500)
var float[]  upe133_arr  = array.from(2.3275, 2.6600, 3.1255, 3.6575, 4.8545, 6.5835, 10.3075, 16.8245, 28.5285, 46.8160, 74.1475, 110.3900, 156.4745, 208.6770, 266.5985, 327.8450, 391.0200, 453.8625, 520.0965, 585.5325, 651.0350)
var float[]  upe15_arr   = array.from(2.6250, 3.0000, 3.5250, 4.1250, 5.4750, 7.4250, 11.6250, 18.9750, 32.1750, 52.8000, 83.6250, 124.5000, 176.4750, 235.3500, 300.6750, 369.7500, 441.0000, 511.8750, 586.5750, 660.3750, 734.2500)
var float[]  lce15_arr   = array.from(341.6667, 312.0000, 276.6333, 243.1000, 210.6667, 178.4000, 146.6333, 116.9333, 88.6667, 64.6667, 44.8667, 30.0000, 19.3667, 12.3667, 8.0667, 5.1667, 3.6000, 2.6333, 2.0333, 1.7000, 1.4000)
var float[]  lce2_arr    = array.from(170.8333, 156.0000, 138.3167, 121.5500, 105.3333, 89.2000, 73.3167, 58.4667, 44.3333, 32.3333, 22.4333, 15.0000, 9.6833, 6.1833, 4.0333, 2.5833, 1.8000, 1.3167, 1.0167, 0.8500, 0.7000)
var float[]  lpe15_arr   = array.from(1.1667, 1.3333, 1.5667, 1.8333, 2.4333, 3.3000, 5.1667, 8.4333, 14.3000, 23.4667, 37.1667, 55.3333, 78.4333, 104.6000, 133.6333, 164.3333, 196.0000, 227.5000, 260.7000, 293.5000, 326.3333)
var float[]  lpe2_arr    = array.from(0.5833, 0.6667, 0.7833, 0.9167, 1.2167, 1.6500, 2.5833, 4.2167, 7.1500, 11.7333, 18.5833, 27.6667, 39.2167, 52.3000, 66.8167, 82.1667, 98.0000, 113.7500, 130.3500, 146.7500, 163.1667)

f_line(y, col, w) =>
    line.new(bar_index-1, y, bar_index, y, extend=extend.both, color=col, width=w)

f_lbl(y, txt, col) =>
    if show_lbl
        label.new(bar_index, y, txt, xloc=xloc.bar_index, yloc=yloc.price,
                  style=label.style_label_left, color=color.new(col,80),
                  textcolor=col, size=size.small)

// -- Auto-ATM: pick the strike in our list nearest the live close --
f_nearest_idx() =>
    var int best = 0
    minDiff = 1e10
    for i = 0 to array.size(strike_arr) - 1
        sk = str.tonumber(array.get(strike_arr, i))
        d = math.abs(close - sk)
        if d < minDiff
            minDiff := d
            best := i
    best

idx = auto_atm ? f_nearest_idx() : array.indexof(strike_arr, selected)

if barstate.islast and idx >= 0
    s = array.get(strike_arr, idx)
    if show_avg
        v = array.get(avg_arr, idx)
        f_line(v, color.new(color.gray, 20), lw)
        f_lbl(v, s + " Avg " + str.tostring(v, "#.00"), color.gray)
    if show_bl
        v = array.get(bl_arr, idx)
        f_line(v, color.new(color.orange, 20), lw)
        f_lbl(v, s + " BL " + str.tostring(v, "#.00"), color.orange)
    if show_uce
        v = array.get(uce133_arr, idx)
        f_line(v, color.new(color.red, 20), lw)
        f_lbl(v, s + " UCEx1.33 " + str.tostring(v, "#.00"), color.red)
        v := array.get(uce15_arr, idx)
        f_line(v, color.new(color.red, 40), lw)
        f_lbl(v, s + " UCEx1.5 " + str.tostring(v, "#.00"), color.red)
    if show_upe
        v = array.get(upe133_arr, idx)
        f_line(v, color.new(color.purple, 20), lw)
        f_lbl(v, s + " UPEx1.33 " + str.tostring(v, "#.00"), color.purple)
        v := array.get(upe15_arr, idx)
        f_line(v, color.new(color.purple, 40), lw)
        f_lbl(v, s + " UPEx1.5 " + str.tostring(v, "#.00"), color.purple)
    if show_lce
        v = array.get(lce15_arr, idx)
        f_line(v, color.new(color.teal, 20), lw)
        f_lbl(v, s + " LCEx1.5 " + str.tostring(v, "#.00"), color.teal)
        v := array.get(lce2_arr, idx)
        f_line(v, color.new(color.teal, 40), lw)
        f_lbl(v, s + " LCEx2 " + str.tostring(v, "#.00"), color.teal)
    if show_lpe
        v = array.get(lpe15_arr, idx)
        f_line(v, color.new(color.blue, 20), lw)
        f_lbl(v, s + " LPEx1.5 " + str.tostring(v, "#.00"), color.blue)
        v := array.get(lpe2_arr, idx)
        f_line(v, color.new(color.blue, 40), lw)
        f_lbl(v, s + " LPEx2 " + str.tostring(v, "#.00"), color.blue)

plot(na, "Individual Average",     color=color.gray)
plot(na, "Boundary Line",          color=color.orange)
plot(na, "Upper Reversal Zone CE", color=color.red)
plot(na, "Upper Reversal Zone PE", color=color.purple)
plot(na, "Lower Reversal Zone CE", color=color.teal)
plot(na, "Lower Reversal Zone PE", color=color.blue)