//@version=5
indicator("Options Reversal Zones - NIFTY 14 Aug 2026 | Expiry: 18AUG2026", overlay=true, max_lines_count=500, max_labels_count=500)

// -- Strike Selector --
// Add this indicator to the UNDERLYING chart (e.g. NIFTY spot/futures),
// not an option chart -- Auto-ATM needs the underlying's live close price.
auto_atm = input.bool(true, "Auto-track ATM to live price")
selected = input.string("24350", "Manual Strike (used when Auto-track is off)", options=["23850", "23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750", "24800", "24850"])

// -- Zone Toggles --
show_avg    = input.bool(true,  "Individual Average")
show_bl     = input.bool(true,  "Boundary Line")
show_uce    = input.bool(true,  "Upper Reversal Zone CE")
show_upe    = input.bool(true,  "Upper Reversal Zone PE")
show_lce    = input.bool(true,  "Lower Reversal Zone CE")
show_lpe    = input.bool(true,  "Lower Reversal Zone PE")
show_lbl    = input.bool(true,  "Show Labels")
lw          = input.int(1, "Line Width", minval=1, maxval=4)

// -- Data (pulled from Angel One this morning, computed here) --
var string[] strike_arr  = array.from("23850", "23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750", "24800", "24850")
var float[]  avg_arr     = array.from(258.2750, 237.2250, 212.4000, 190.1750, 168.3500, 147.8750, 128.7000, 113.2750, 100.5250, 92.3500, 88.0000, 88.4500, 93.9500, 104.0250, 117.4250, 134.4500, 154.0750, 175.2000, 197.9750, 221.5750, 248.0750)
var float[]  bl_arr      = array.from(0, 0, 164.9500, 142.7250, 121.0750, 102.0250, 84.4750, 70.0250, 58.3250, 50.7000, 47.1000, 48.0500, 52.8000, 61.3750, 74.0250, 89.8000, 107.6750, 127.9750, 149.7750, 170.8250, 194.8000)
var float[]  uce133_arr  = array.from(682.8885, 625.7650, 558.1345, 496.4225, 434.6440, 374.3950, 315.2100, 261.9435, 211.5365, 167.3140, 128.0125, 95.4940, 69.4260, 49.4760, 34.3805, 23.4745, 16.4255, 11.6375, 8.4455, 6.2510, 4.9875)
var float[]  uce15_arr   = array.from(770.1750, 705.7500, 629.4750, 559.8750, 490.2000, 422.2500, 355.5000, 295.4250, 238.5750, 188.7000, 144.3750, 107.7000, 78.3000, 55.8000, 38.7750, 26.4750, 18.5250, 13.1250, 9.5250, 7.0500, 5.6250)
var float[]  upe133_arr  = array.from(4.1230, 5.2535, 6.8495, 9.4430, 13.1670, 18.9525, 27.1320, 39.3680, 55.8600, 78.3370, 106.0675, 139.7830, 180.4810, 227.2305, 277.9700, 334.1625, 393.4140, 454.3945, 518.1680, 583.1385, 654.8920)
var float[]  upe15_arr   = array.from(4.6500, 5.9250, 7.7250, 10.6500, 14.8500, 21.3750, 30.6000, 44.4000, 63.0000, 88.3500, 119.6250, 157.6500, 203.5500, 256.2750, 313.5000, 376.8750, 443.7000, 512.4750, 584.4000, 657.6750, 738.6000)
var float[]  lce15_arr   = array.from(342.3000, 313.6667, 279.7667, 248.8333, 217.8667, 187.6667, 158.0000, 131.3000, 106.0333, 83.8667, 64.1667, 47.8667, 34.8000, 24.8000, 17.2333, 11.7667, 8.2333, 5.8333, 4.2333, 3.1333, 2.5000)
var float[]  lce2_arr    = array.from(171.1500, 156.8333, 139.8833, 124.4167, 108.9333, 93.8333, 79.0000, 65.6500, 53.0167, 41.9333, 32.0833, 23.9333, 17.4000, 12.4000, 8.6167, 5.8833, 4.1167, 2.9167, 2.1167, 1.5667, 1.2500)
var float[]  lpe15_arr   = array.from(2.0667, 2.6333, 3.4333, 4.7333, 6.6000, 9.5000, 13.6000, 19.7333, 28.0000, 39.2667, 53.1667, 70.0667, 90.4667, 113.9000, 139.3333, 167.5000, 197.2000, 227.7667, 259.7333, 292.3000, 328.2667)
var float[]  lpe2_arr    = array.from(1.0333, 1.3167, 1.7167, 2.3667, 3.3000, 4.7500, 6.8000, 9.8667, 14.0000, 19.6333, 26.5833, 35.0333, 45.2333, 56.9500, 69.6667, 83.7500, 98.6000, 113.8833, 129.8667, 146.1500, 164.1333)

f_line(y, col, w) =>
    line.new(bar_index-1, y, bar_index, y, extend=extend.both, color=col, width=w)

f_lbl(y, txt, col) =>
    if show_lbl
        label.new(bar_index, y, txt, xloc=xloc.bar_index, yloc=yloc.price,
                  style=label.style_label_left, color=color.new(col,80),
                  textcolor=col, size=size.small)

// -- Auto-ATM: pick the strike in our list nearest the live close --
f_nearest_idx() =>
    var int best = 0
    minDiff = 1e10
    for i = 0 to array.size(strike_arr) - 1
        sk = str.tonumber(array.get(strike_arr, i))
        d = math.abs(close - sk)
        if d < minDiff
            minDiff := d
            best := i
    best

idx = auto_atm ? f_nearest_idx() : array.indexof(strike_arr, selected)

if barstate.islast and idx >= 0
    s = array.get(strike_arr, idx)
    if show_avg
        v = array.get(avg_arr, idx)
        f_line(v, color.new(color.gray, 20), lw)
        f_lbl(v, s + " Avg " + str.tostring(v, "#.00"), color.gray)
    if show_bl
        v = array.get(bl_arr, idx)
        f_line(v, color.new(color.orange, 20), lw)
        f_lbl(v, s + " BL " + str.tostring(v, "#.00"), color.orange)
    if show_uce
        v = array.get(uce133_arr, idx)
        f_line(v, color.new(color.red, 20), lw)
        f_lbl(v, s + " UCEx1.33 " + str.tostring(v, "#.00"), color.red)
        v := array.get(uce15_arr, idx)
        f_line(v, color.new(color.red, 40), lw)
        f_lbl(v, s + " UCEx1.5 " + str.tostring(v, "#.00"), color.red)
    if show_upe
        v = array.get(upe133_arr, idx)
        f_line(v, color.new(color.purple, 20), lw)
        f_lbl(v, s + " UPEx1.33 " + str.tostring(v, "#.00"), color.purple)
        v := array.get(upe15_arr, idx)
        f_line(v, color.new(color.purple, 40), lw)
        f_lbl(v, s + " UPEx1.5 " + str.tostring(v, "#.00"), color.purple)
    if show_lce
        v = array.get(lce15_arr, idx)
        f_line(v, color.new(color.teal, 20), lw)
        f_lbl(v, s + " LCEx1.5 " + str.tostring(v, "#.00"), color.teal)
        v := array.get(lce2_arr, idx)
        f_line(v, color.new(color.teal, 40), lw)
        f_lbl(v, s + " LCEx2 " + str.tostring(v, "#.00"), color.teal)
    if show_lpe
        v = array.get(lpe15_arr, idx)
        f_line(v, color.new(color.blue, 20), lw)
        f_lbl(v, s + " LPEx1.5 " + str.tostring(v, "#.00"), color.blue)
        v := array.get(lpe2_arr, idx)
        f_line(v, color.new(color.blue, 40), lw)
        f_lbl(v, s + " LPEx2 " + str.tostring(v, "#.00"), color.blue)

plot(na, "Individual Average",     color=color.gray)
plot(na, "Boundary Line",          color=color.orange)
plot(na, "Upper Reversal Zone CE", color=color.red)
plot(na, "Upper Reversal Zone PE", color=color.purple)
plot(na, "Lower Reversal Zone CE", color=color.teal)
plot(na, "Lower Reversal Zone PE", color=color.blue)