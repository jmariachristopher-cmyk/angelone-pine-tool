//@version=5
indicator("Options Reversal Zones - NIFTY 18 Aug 2026 | Expiry: 18AUG2026", overlay=true, max_lines_count=500, max_labels_count=500)

// -- Strike Selector --
// Add this indicator to the UNDERLYING chart (e.g. NIFTY spot/futures),
// not an option chart -- Auto-ATM needs the underlying's live close price.
auto_atm = input.bool(true, "Auto-track ATM to live price")
selected = input.string("24250", "Manual Strike (used when Auto-track is off)", options=["23750", "23800", "23850", "23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750"])

// -- Zone Toggles --
show_avg    = input.bool(true,  "Individual Average")
show_bl     = input.bool(true,  "Boundary Line")
show_uce    = input.bool(true,  "Upper Reversal Zone CE")
show_upe    = input.bool(true,  "Upper Reversal Zone PE")
show_lce    = input.bool(true,  "Lower Reversal Zone CE")
show_lpe    = input.bool(true,  "Lower Reversal Zone PE")
show_lbl    = input.bool(true,  "Show Labels")
lw          = input.int(1, "Line Width", minval=1, maxval=4)

// -- Data (pulled from Angel One this morning, computed here) --
var string[] strike_arr  = array.from("23750", "23800", "23850", "23900", "23950", "24000", "24050", "24100", "24150", "24200", "24250", "24300", "24350", "24400", "24450", "24500", "24550", "24600", "24650", "24700", "24750")
var float[]  avg_arr     = array.from(241.5750, 216.8000, 191.6000, 167.2750, 141.9000, 118.1000, 93.6250, 70.9250, 51.2500, 39.0000, 37.1000, 47.6250, 65.6750, 87.7750, 111.2500, 135.6000, 160.1750, 184.9750, 210.0250, 234.4250, 259.7750)
var float[]  bl_arr      = array.from(0, 0, 141.7000, 117.6500, 92.9000, 69.1500, 46.9000, 28.4500, 15.2250, 9.0500, 8.2250, 13.1750, 24.0750, 41.6250, 62.9500, 86.4000, 110.5750, 135.1500, 159.9000, 184.4500, 209.5500)
var float[]  uce133_arr  = array.from(641.8580, 575.9565, 508.7915, 443.8875, 376.1905, 312.2175, 246.2495, 182.8750, 123.4905, 73.7485, 37.7055, 18.2875, 9.0440, 5.0540, 3.0590, 2.3275, 1.7955, 1.3965, 1.2635, 1.1305, 1.0640)
var float[]  uce15_arr   = array.from(723.9000, 649.5750, 573.8250, 500.6250, 424.2750, 352.1250, 277.7250, 206.2500, 139.2750, 83.1750, 42.5250, 20.6250, 10.2000, 5.7000, 3.4500, 2.6250, 2.0250, 1.5750, 1.4250, 1.2750, 1.2000)
var float[]  upe133_arr  = array.from(0.7315, 0.7315, 0.8645, 1.0640, 1.2635, 1.9285, 2.7930, 5.7855, 12.8345, 29.9915, 60.9805, 108.3950, 165.6515, 228.4275, 292.8660, 358.3685, 424.2700, 490.6370, 557.4030, 622.4400, 689.9375)
var float[]  upe15_arr   = array.from(0.8250, 0.8250, 0.9750, 1.2000, 1.4250, 2.1750, 3.1500, 6.5250, 14.4750, 33.8250, 68.7750, 122.2500, 186.8250, 257.6250, 330.3000, 404.1750, 478.5000, 553.3500, 628.6500, 702.0000, 778.1250)
var float[]  lce15_arr   = array.from(321.7333, 288.7000, 255.0333, 222.5000, 188.5667, 156.5000, 123.4333, 91.6667, 61.9000, 36.9667, 18.9000, 9.1667, 4.5333, 2.5333, 1.5333, 1.1667, 0.9000, 0.7000, 0.6333, 0.5667, 0.5333)
var float[]  lce2_arr    = array.from(160.8667, 144.3500, 127.5167, 111.2500, 94.2833, 78.2500, 61.7167, 45.8333, 30.9500, 18.4833, 9.4500, 4.5833, 2.2667, 1.2667, 0.7667, 0.5833, 0.4500, 0.3500, 0.3167, 0.2833, 0.2667)
var float[]  lpe15_arr   = array.from(0.3667, 0.3667, 0.4333, 0.5333, 0.6333, 0.9667, 1.4000, 2.9000, 6.4333, 15.0333, 30.5667, 54.3333, 83.0333, 114.5000, 146.8000, 179.6333, 212.6667, 245.9333, 279.4000, 312.0000, 345.8333)
var float[]  lpe2_arr    = array.from(0.1833, 0.1833, 0.2167, 0.2667, 0.3167, 0.4833, 0.7000, 1.4500, 3.2167, 7.5167, 15.2833, 27.1667, 41.5167, 57.2500, 73.4000, 89.8167, 106.3333, 122.9667, 139.7000, 156.0000, 172.9167)

f_line(y, col, w) =>
    line.new(bar_index-1, y, bar_index, y, extend=extend.both, color=col, width=w)

f_lbl(y, txt, col) =>
    if show_lbl
        label.new(bar_index, y, txt, xloc=xloc.bar_index, yloc=yloc.price,
                  style=label.style_label_left, color=color.new(col,80),
                  textcolor=col, size=size.small)

// -- Auto-ATM: pick the strike in our list nearest the live close --
f_nearest_idx() =>
    var int best = 0
    minDiff = 1e10
    for i = 0 to array.size(strike_arr) - 1
        sk = str.tonumber(array.get(strike_arr, i))
        d = math.abs(close - sk)
        if d < minDiff
            minDiff := d
            best := i
    best

idx = auto_atm ? f_nearest_idx() : array.indexof(strike_arr, selected)

if barstate.islast and idx >= 0
    s = array.get(strike_arr, idx)
    if show_avg
        v = array.get(avg_arr, idx)
        f_line(v, color.new(color.gray, 20), lw)
        f_lbl(v, s + " Avg " + str.tostring(v, "#.00"), color.gray)
    if show_bl
        v = array.get(bl_arr, idx)
        f_line(v, color.new(color.orange, 20), lw)
        f_lbl(v, s + " BL " + str.tostring(v, "#.00"), color.orange)
    if show_uce
        v = array.get(uce133_arr, idx)
        f_line(v, color.new(color.red, 20), lw)
        f_lbl(v, s + " UCEx1.33 " + str.tostring(v, "#.00"), color.red)
        v := array.get(uce15_arr, idx)
        f_line(v, color.new(color.red, 40), lw)
        f_lbl(v, s + " UCEx1.5 " + str.tostring(v, "#.00"), color.red)
    if show_upe
        v = array.get(upe133_arr, idx)
        f_line(v, color.new(color.purple, 20), lw)
        f_lbl(v, s + " UPEx1.33 " + str.tostring(v, "#.00"), color.purple)
        v := array.get(upe15_arr, idx)
        f_line(v, color.new(color.purple, 40), lw)
        f_lbl(v, s + " UPEx1.5 " + str.tostring(v, "#.00"), color.purple)
    if show_lce
        v = array.get(lce15_arr, idx)
        f_line(v, color.new(color.teal, 20), lw)
        f_lbl(v, s + " LCEx1.5 " + str.tostring(v, "#.00"), color.teal)
        v := array.get(lce2_arr, idx)
        f_line(v, color.new(color.teal, 40), lw)
        f_lbl(v, s + " LCEx2 " + str.tostring(v, "#.00"), color.teal)
    if show_lpe
        v = array.get(lpe15_arr, idx)
        f_line(v, color.new(color.blue, 20), lw)
        f_lbl(v, s + " LPEx1.5 " + str.tostring(v, "#.00"), color.blue)
        v := array.get(lpe2_arr, idx)
        f_line(v, color.new(color.blue, 40), lw)
        f_lbl(v, s + " LPEx2 " + str.tostring(v, "#.00"), color.blue)

plot(na, "Individual Average",     color=color.gray)
plot(na, "Boundary Line",          color=color.orange)
plot(na, "Upper Reversal Zone CE", color=color.red)
plot(na, "Upper Reversal Zone PE", color=color.purple)
plot(na, "Lower Reversal Zone CE", color=color.teal)
plot(na, "Lower Reversal Zone PE", color=color.blue)